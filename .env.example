# Moscow Cigar 环境配置
# 复制为 .env 并填入真实值
#
# DEBUG=True  → 使用 cigars_dev.db（开发库）
# DEBUG=False → 使用 cigars.db（生产库）

DJANGO_DEBUG=False
DJANGO_SECRET_KEY=your-secret-key-here

# 爬虫密码
LCDH_DL_PASSWORD=

# 对外发送给客户的收款链接根地址，例如 https://pay.example.com
PRIVNOTE_BASE_URL=

# 内部 Telegram 通知。固定 Chat ID 已有安全默认值，也可在部署环境覆盖。
# Bot Token 是密钥，只配置在部署环境，不提交真实值。
TELEGRAM_BOT_TOKEN=
TELEGRAM_BUSINESS_CHAT_ID=-1003900174592
TELEGRAM_ERROR_CHAT_ID=8206776258

# 工作人员通知中的网站链接；留空时沿用 PRIVNOTE_BASE_URL。
INTERNAL_SITE_URL=
