[Unit]
Description=CigarDomTabaka public storefront prerender worker
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/opt/cigardomtabaka
EnvironmentFile=/opt/cigardomtabaka/.env
ExecStart=/opt/cigardomtabaka/venv/bin/python manage.py render_storefront --watch
Restart=always
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
