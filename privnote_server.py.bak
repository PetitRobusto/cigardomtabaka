#!/usr/bin/env python3
"""Privnote 临时服务 — 雪茄品牌页阅后即焚包装"""
import os, sys, json, uuid, hashlib, time, sqlite3
from http.server import HTTPServer, BaseHTTPRequestHandler
from urllib.parse import urlparse, parse_qs

DB = '/home/jason/moscow_cigar/cigars.db'
STORE = {}  # note_id → {html, created_at, viewed}
TTL = 3600  # 1小时自动过期
PORT = 9090


def get_brand_data(slug):
    """从 cigars.db 拉取品牌+雪茄数据"""
    conn = sqlite3.connect(DB)
    conn.row_factory = sqlite3.Row
    c = conn.cursor()

    # 品牌
    brand = c.execute("SELECT * FROM cigars_brand WHERE slug=?", (slug,)).fetchone()
    if not brand:
        conn.close()
        return None

    # 雪茄列表（带图片）
    cigars = c.execute("""
        SELECT c.*, ci.thumbnail as thumb_url
        FROM cigars_cigar c
        LEFT JOIN cigars_cigarimage ci ON ci.cigar_id = c.id AND ci.is_primary = 1
        WHERE c.brand = ?
        ORDER BY c.english_name
    """, (brand['english_name'],)).fetchall()

    conn.close()
    return {'brand': dict(brand), 'cigars': [dict(r) for r in cigars]}


SECTION_ORDER = [
    ('', '📦 常规款'),
    ('Limited Edition Series', '限量版'),
    ('Regional Edition Series', '地区限量版'),
    ('Commemorative Release', '纪念版'),
    ('Habanos Collection Series', '哈瓦那收藏系列'),
    ('Reserve Series', '珍藏系列'),
    ('Grand Reserve Series', '特级珍藏系列'),
    ('Millennium Reserve Series', '千禧珍藏系列'),
    ('Aged Habanos Series', '陈年哈瓦那系列'),
    ('Duty Free and Travel Retail Series', '免税及旅行零售系列'),
    ('Chinese Year Series', '中国年份系列'),
    ('Replica Antique Humidor Series', '复刻古董保湿盒系列'),
    ('Vintage Series', '年份系列'),
    ('Special Events', '特别活动'),
    ('Other Special Release', '其他特别版'),
]


def build_privnote_html(data):
    """生成 privnote 包装的雪茄品牌详情页"""
    brand = data['brand']
    all_cigars = data['cigars']

    # 分组
    groups = {}
    for c in all_cigars:
        rt = (c.get('release_type') or '')
        groups.setdefault(rt, []).append(c)

    # 渲染 sections
    sections_html = ''
    for rt_key, rt_label in SECTION_ORDER:
        if rt_key not in groups:
            continue
        items = groups[rt_key]
        rows = ''
        for c in items:
            thumb_html = ''
            thumb = c.get('thumb_url')
            if thumb:
                thumb_html = f'''<div class="cigar-thumb"><img src="/media/{thumb}" alt="" loading="lazy"></div>'''
            else:
                thumb_html = '<div class="cigar-thumb no-img">🚬</div>'

            name = c.get('name') or c.get('english_name') or '???'
            en = c.get('english_name') or ''
            vitola = c.get('vitola') or ''
            length = c.get('length') or ''
            ring = c.get('ring_gauge') or ''
            meta = f'{vitola}'
            if length and ring:
                meta += f' · {int(length)}×{int(ring)}'
            origin_cn = c.get('origin') or 'Cuban'

            rows += f'''<tr>
              <td><div class="cigar-cell">{thumb_html}<div><div class="cigar-name">{name} <span class="en">{en}</span></div><div class="cigar-tags">{meta}</div></div></div></td>
              <td class="num">{origin_cn}</td>
            </tr>'''

        sections_html += f'''<div class="section">
          <div class="section-title">{rt_label} ({len(items)})</div>
          <table class="inv-table"><tbody>{rows}</tbody></table>
        </div>'''

    brand_name = brand.get('name') or brand.get('english_name') or '???'
    total = len(all_cigars)

    return f'''<!DOCTYPE html>
<html lang="zh">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Privnote · {brand_name}</title>
<style>
*{{margin:0;padding:0;box-sizing:border-box}}
body{{
  font-family:'Georgia','Noto Serif SC',serif;
  background:linear-gradient(135deg,#1a1410,#2D1F14,#1a1410);
  color:#EDE4D3;min-height:100vh;padding:24px;
}}
.card{{
  max-width:860px;margin:0 auto;
  background:linear-gradient(180deg,#2D1F14,#1a1410);
  border:1px solid #C8A45C30;border-radius:6px;
  box-shadow:0 8px 40px #00000050;overflow:hidden;
}}
.pn-header{{
  background:#C8A45C12;border-bottom:1px solid #C8A45C20;
  padding:20px 28px;display:flex;align-items:center;gap:12px;
}}
.pn-icon{{font-size:28px}}
.pn-title{{font-size:15px;font-weight:bold;letter-spacing:1px;color:#C8A45C}}
.pn-meta{{font-size:11px;color:#8B7E6A;margin-top:2px}}
.pn-badge{{
  margin-left:auto;font-size:10px;padding:4px 12px;
  border-radius:3px;background:#8B2E2E20;color:#D48888;
  border:1px solid #8B2E2E30;letter-spacing:1px;animation:pulse 2s infinite;
}}
@keyframes pulse{{0%,100%{{opacity:1}}50%{{opacity:.5}}}}
.pn-status{{
  padding:14px 28px;border-bottom:1px dashed #C8A45C20;
  font-size:12px;color:#8B7E6A;display:flex;align-items:center;gap:10px;
}}
.pn-status .dot{{width:8px;height:8px;border-radius:50%;background:#4A7C4A}}
.brand-header{{text-align:center;padding:32px 28px 16px}}
.brand-header h1{{font-size:22px;font-weight:normal;letter-spacing:2px;color:#C8A45C}}
.brand-header .count{{font-size:12px;color:#8B7E6A;margin-top:4px}}
.section{{margin:0 28px 24px}}
.section-title{{
  font-size:11px;color:#8B7E6A;letter-spacing:2px;text-transform:uppercase;
  padding-bottom:8px;border-bottom:1px solid #C8A45C15;margin-bottom:8px;
}}
.inv-table{{width:100%;border-collapse:collapse;font-size:12px}}
.inv-table td{{padding:10px 0;border-bottom:1px solid #C8A45C06;vertical-align:middle}}
.inv-table tr:hover{{background:#C8A45C06}}
.inv-table .num{{text-align:right;color:#8B7E6A;width:80px}}
.cigar-cell{{display:flex;align-items:center;gap:12px}}
.cigar-thumb{{
  width:44px;height:44px;flex-shrink:0;background:#1a1410;
  border:1px solid #C8A45C15;border-radius:2px;
  display:flex;align-items:center;justify-content:center;overflow:hidden;
}}
.cigar-thumb img{{max-width:100%;max-height:100%;object-fit:contain}}
.cigar-thumb.no-img{{font-size:18px;opacity:.3}}
.cigar-name{{font-size:13px;font-weight:bold;color:#EDE4D3}}
.cigar-name .en{{font-size:10px;color:#8B7E6A;font-weight:normal;margin-left:4px}}
.cigar-tags{{font-size:10px;color:#8B7E6A;margin-top:1px}}
.pn-footer{{
  padding:14px 28px;border-top:1px dashed #C8A45C20;
  display:flex;justify-content:space-between;font-size:10px;color:#8B7E6A50;
}}
.pn-footer .burn{{color:#8B4545;letter-spacing:1px}}
</style>
</head>
<body>
<div class="card">
  <div class="pn-header">
    <span class="pn-icon">🔥</span>
    <div><div class="pn-title">Privnote · 雪茄目录快照</div><div class="pn-meta">阅后即焚 · 关闭页面后无法再次访问</div></div>
    <span class="pn-badge">一次性链接</span>
  </div>
  <div class="pn-status">
    <span class="dot"></span><span>此页面仅可查看一次</span>
  </div>
  <div class="brand-header">
    <h1>{brand_name}</h1>
    <div class="count">{total} 款雪茄</div>
  </div>
  {sections_html}
  <div class="pn-footer">
    <span>莫斯科仓 · 仅供内部参考</span>
    <span class="burn">⚠ 关闭后立即销毁</span>
  </div>
</div>
</body>
</html>'''


class Handler(BaseHTTPRequestHandler):
    def do_GET(self):
        path = urlparse(self.path).path

        # 媒体文件代理
        if path.startswith('/media/'):
            media_path = '/home/jason/moscow_cigar' + path
            if os.path.isfile(media_path):
                self.send_response(200)
                ext = path.rsplit('.', 1)[-1].lower()
                ct = {'jpg': 'image/jpeg', 'png': 'image/png', 'webp': 'image/webp', 'gif': 'image/gif'}.get(ext, 'application/octet-stream')
                self.send_header('Content-Type', ct)
                self.end_headers()
                with open(media_path, 'rb') as f:
                    self.wfile.write(f.read())
            else:
                self.send_error(404)
            return

        # 首页 — 品牌列表
        if path == '/':
            self._serve_index()
            return

        # 生成 privnote 链接
        if path.startswith('/gen/'):
            slug = path.split('/gen/')[1].strip('/')
            data = get_brand_data(slug)
            if not data:
                self.send_error(404, '品牌不存在')
                return

            html = build_privnote_html(data)
            note_id = uuid.uuid4().hex[:12]
            STORE[note_id] = {
                'html': html,
                'created_at': time.time(),
                'viewed': False,
                'brand': data['brand'].get('name') or data['brand'].get('english_name'),
            }

            # 返回 privnote 链接
            self.send_response(200)
            self.send_header('Content-Type', 'text/html; charset=utf-8')
            self.end_headers()
            link = f'http://localhost:{PORT}/n/{note_id}'
            self.wfile.write(f'''<!DOCTYPE html>
<html lang="zh"><head><meta charset="UTF-8">
<title>Privnote · 链接已生成</title>
<style>
body{{font-family:Georgia,serif;background:#1a1410;color:#EDE4D3;display:flex;align-items:center;justify-content:center;min-height:100vh;margin:0}}
.card{{background:#2D1F14;border:1px solid #C8A45C30;border-radius:6px;padding:40px;text-align:center;max-width:500px}}
h2{{color:#C8A45C;font-size:18px;margin-bottom:12px}}
.link{{display:block;background:#1a1410;border:1px dashed #C8A45C30;border-radius:4px;padding:16px;margin:16px 0;font-size:14px;color:#C8A45C;word-break:break-all;text-decoration:none}}
.link:hover{{border-color:#C8A45C}}
.hint{{font-size:11px;color:#8B7E6A}}
.burn{{color:#8B4545;font-size:10px;margin-top:16px}}
</style></head>
<body>
<div class="card">
  <h2>🔥 Privnote 已生成</h2>
  <p style="color:#8B7E6A;font-size:12px">品牌：{data['brand'].get('name') or data['brand'].get('english_name')} · {len(data['cigars'])} 款</p>
  <a class="link" href="{link}">{link}</a>
  <div class="hint">⚠️ 此链接仅可访问一次，关闭后立即销毁</div>
  <div class="burn">🕐 1小时后自动过期</div>
</div>
</body></html>'''.encode('utf-8'))
            return

        # 查看 privnote
        if path.startswith('/n/'):
            note_id = path.split('/n/')[1].strip('/')
            note = STORE.get(note_id)

            if not note:
                self.send_response(404)
                self.send_header('Content-Type', 'text/html; charset=utf-8')
                self.end_headers()
                self.wfile.write('<html><body style="background:#1a1410;color:#8B4545;font-family:Georgia;display:flex;align-items:center;justify-content:center;height:100vh"><div style="text-align:center"><h1>🔥 已销毁</h1><p>此 Privnote 已被查看或已过期</p></div></body></html>'.encode('utf-8'))
                return

            if note['viewed']:
                del STORE[note_id]
                self.send_response(404)
                self.send_header('Content-Type', 'text/html; charset=utf-8')
                self.end_headers()
                self.wfile.write('<html><body style="background:#1a1410;color:#8B4545;font-family:Georgia;display:flex;align-items:center;justify-content:center;height:100vh"><div style="text-align:center"><h1>🔥 已销毁</h1><p>此 Privnote 已被查看或已过期</p></div></body></html>'.encode('utf-8'))
                return

            # 首次查看 — 返回内容，标记已查看
            note['viewed'] = True
            self.send_response(200)
            self.send_header('Content-Type', 'text/html; charset=utf-8')
            self.end_headers()
            self.wfile.write(note['html'].encode('utf-8'))
            return

        self.send_error(404)

    def _serve_index(self):
        """品牌列表首页"""
        conn = sqlite3.connect(DB)
        conn.row_factory = sqlite3.Row
        brands = conn.execute("SELECT * FROM cigars_brand ORDER BY english_name").fetchall()
        conn.close()

        rows = ''
        for b in brands:
            name = b['name'] or b['english_name']
            slug = b['slug']
            rows += f'<tr><td><a href="/gen/{slug}">{name}</a></td><td style="color:#8B7E6A;font-size:11px">{b["english_name"]}</td></tr>'

        html = f'''<!DOCTYPE html>
<html lang="zh"><head><meta charset="UTF-8">
<title>Privnote · 雪茄品牌</title>
<style>
body{{font-family:Georgia,serif;background:#1a1410;color:#EDE4D3;padding:40px 24px}}
.card{{max-width:600px;margin:0 auto;background:#2D1F14;border:1px solid #C8A45C30;border-radius:6px;overflow:hidden}}
h2{{text-align:center;padding:24px;color:#C8A45C;font-size:16px;letter-spacing:2px;border-bottom:1px solid #C8A45C15;margin:0}}
table{{width:100%;border-collapse:collapse}}
td{{padding:10px 20px;border-bottom:1px solid #C8A45C06;font-size:13px}}
a{{color:#C8A45C;text-decoration:none}}
a:hover{{color:#EDE4D3}}
.hint{{padding:16px;text-align:center;font-size:10px;color:#8B7E6A50}}
</style></head>
<body>
<div class="card">
  <h2>🔥 Privnote · 雪茄品牌</h2>
  <table><tbody>{rows}</tbody></table>
  <div class="hint">点击品牌生成一次性 Privnote 链接</div>
</div>
</body></html>'''

        self.send_response(200)
        self.send_header('Content-Type', 'text/html; charset=utf-8')
        self.end_headers()
        self.wfile.write(html.encode('utf-8'))


if __name__ == '__main__':
    print(f'🔥 Privnote 服务启动 → http://localhost:{PORT}')
    HTTPServer(('0.0.0.0', PORT), Handler).serve_forever()
